# Copy to .env and fill in. Keep comments on their own lines.

# Phase 2 — news analysis (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Phase 2 — optional, extra US company news, free tier (finnhub.io)
FINNHUB_API_KEY=

# Optional news-model settings
# default claude-opus-5; cheaper: claude-sonnet-5 or claude-haiku-4-5
# NEWS_MODEL=claude-opus-5
# low | medium | high (ignored for Haiku)
# NEWS_EFFORT=low

# Dashboard password — required when deployed (leave empty locally for no login)
APP_PASSWORD=

# Virtual trades in a private GitHub Gist (shared by PC, cloud and bot).
# Token: github.com/settings/personal-access-tokens → Fine-grained → Account permissions → Gists: Read and write
GITHUB_TOKEN=
# Filled in automatically by: python cli.py gist-setup
PAPER_GIST_ID=

# Phase 4 — from @BotFather
TELEGRAM_BOT_TOKEN=
# Phase 4 — your own chat id, so only you can use the bot
TELEGRAM_CHAT_ID=
