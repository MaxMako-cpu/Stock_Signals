# Copy to .env and fill in. Keep comments on their own lines.

# Phase 2 — news analysis (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Phase 2 — optional, extra US company news, free tier (finnhub.io)
FINNHUB_API_KEY=

# Optional news-model settings
# default claude-opus-5; cheaper: claude-sonnet-5 or claude-haiku-4-5
# NEWS_MODEL=claude-opus-5
# low | medium | high (ignored for Haiku)
# NEWS_EFFORT=low

# Phase 4 — from @BotFather
TELEGRAM_BOT_TOKEN=
# Phase 4 — your own chat id, so only you can use the bot
TELEGRAM_CHAT_ID=
